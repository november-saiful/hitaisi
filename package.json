{
  "name": "hitaisi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && npm run build:worker",
    "build:web": "vite build --config web/vite.config.ts",
    "build:worker": "esbuild src/worker/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/worker.js --external:cloudflare:workers",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types src/worker/env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply benevolent-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply benevolent-db --remote",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251016.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
